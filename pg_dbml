#!/usr/bin/env bash
# =============================================================================
# pg_dbml - PostgreSQL → DBML exporter (pure SQL, sorted by schema.table)
# =============================================================================

set -euo pipefail

VERSION="1.1.3"
QUIET=0
DRY_RUN=0

if ! command -v psql &> /dev/null; then
	echo "Error: 'psql' not found. Please install PostgreSQL client." >&2
	exit 1
fi

if [[ "${1:-}" == "--version" || "${1:-}" == "-v" ]]; then
	echo "$VERSION"
	exit 0
fi

usage() {
	cat << EOF
Usage: pg_dbml [OPTIONS] [DBNAME]
	 or: pg_dbml postgresql://[user[:password]@][host][:port][/dbname]

Connection parameters are forwarded to psql only when given, so psql's own
defaults and environment variables apply to everything you omit.

Parameters:
	-h, --host HOST      Host (default: PGHOST, else local socket)
	-p, --port PORT      Port (default: PGPORT, else 5432)
	-U, --user USER      User (default: PGUSER, else OS user name)
	-d, --dbname DBNAME  Database name (default: PGDATABASE, else user name)
	-o, --output FILE    Output file (default: DBNAME.dbml)
	-q, --quiet          Suppress success message
	    --dry-run        Preview output without writing file
	-v, --version        Show script version
	--help               This help

Examples:
	pg_dbml                       # use psql defaults / environment
	pg_dbml mydb
	pg_dbml -d mydb -q
	pg_dbml -d mydb --dry-run
	pg_dbml postgresql://user@localhost:5432/mydb
EOF
}

# Default connection and config values
DBNAME=""
OUTPUT=""
CONNSTR=""
QUIET=0
DRY_RUN=0
PSQL_ARGS=(
  -v ON_ERROR_STOP=on
  --no-psqlrc
  --tuples-only
  --no-align
)

while [[ $# -gt 0 ]]; do
	case $1 in
		-h|--host)       PSQL_ARGS+=(-h "${2}"); shift 2 ;;
		-p|--port)       PSQL_ARGS+=(-p "${2}"); shift 2 ;;
		-U|--user)       PSQL_ARGS+=(-U "${2}"); shift 2 ;;
		-d|--dbname)     PSQL_ARGS+=(-d "${2}"); DBNAME="${2}"; shift 2 ;;
		-o|--output)     OUTPUT="${2}"; shift 2 ;;
		-q|--quiet)      QUIET=1; shift ;;
		--dry-run)       DRY_RUN=1; shift ;;
		-v|--version)    echo "$VERSION"; exit 0 ;;
		--help)          usage; exit 0 ;;
		postgresql://*)  PSQL_ARGS+=("${1}"); CONNSTR="${1}";  shift ;;
		*)               PSQL_ARGS+=(-d "${1}"); DBNAME="${1}"; shift ;;
	esac
done

if [[ -n "${CONNSTR:-}" ]]; then

	#  CONNSTR="postgresql://user:pass@host:5432/mydb?sslmode=require"
	DBNAME="$(printf '%s\n' "$CONNSTR" | sed -E 's|^postgresql://([^/@]+(:[^/@]*)?@)?([^/:?]+)?(:[0-9]+)?/?([^?]*)?.*$|\5|')"
	DBNAME="${DBNAME:-$USER}"
fi

if [[ -z "$OUTPUT" ]]; then
	# default DB name is same as username
	OUTPUT="${DBNAME:-$USER}.dbml"
fi

# ─────────────────────────────────────────────────────────────
# Resolve and read the SQL query file
# ─────────────────────────────────────────────────────────────
# Path resolution priority:
# 1. PG_DBML_SQL_PATH (Set by Homebrew wrapper during installation)
# 2. Local fallback paths (For local development/execution)

if [[ -n "${PG_DBML_SQL_PATH:-}" ]]; then
	SQL_FILE="${PG_DBML_SQL_PATH}"
else
	if [[ -f "pg_dbml.sql" ]]; then
		SQL_FILE="pg_dbml.sql"
	elif [[ -f "sql/pg_dbml.sql" ]]; then
		SQL_FILE="sql/pg_dbml.sql"
	elif [[ -f "$(dirname "$0")/pg_dbml.sql" ]]; then
		SQL_FILE="$(dirname "$0")/pg_dbml.sql"
	else
		echo "Error: pg_dbml.sql file not found!" >&2
		echo "Please place it in the same directory, 'sql/' subdirectory, or use the Homebrew installation." >&2
		exit 1
	fi
fi

SQL=$(cat "$SQL_FILE")

if [[ $DRY_RUN == 1 ]]; then

	psql "${PSQL_ARGS[@]}" -c "$SQL"

else
	if psql "${PSQL_ARGS[@]}" --quiet -c "$SQL" > "$OUTPUT"; then

		if [[ "${QUIET}" == 0 ]]; then
			echo "✅ DBML generated → $OUTPUT"
		fi
	else
		exit "${?}"
	fi
fi
